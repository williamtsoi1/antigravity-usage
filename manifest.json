{
  "schemaVersion": 1,
  "id": "jesseburlamaque.antigravity-usage",
  "name": "Antigravity Usage",
  "version": "1.3.9",
  "author": "Jesse Burlamaque & contributors",
  "license": "MIT",
  "description": "Antigravity active sessions, live quota limits (/usage) or actual token usage, model breakdown, prompt history, and tool telemetry in the Omarchy bar.",
  "kinds": ["bar-widget"],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Widget.qml"
  },
  "barWidget": {
    "displayName": "Antigravity Usage",
    "description": "Shows Antigravity active agent status, quota limits or actual token usage, sessions, prompt stats, and tool usage.",
    "category": "AI",
    "allowMultiple": false,
    "defaults": {
      "usageMode": "prompts",
      "refreshIntervalSec": 60,
      "badgeMode": "active",
      "showBadge": true,
      "enableQuotaAlerts": true,
      "quotaAlertThreshold": 15,
      "terminalCommand": "",
      "recentSessionsLimit": 5
    },
    "schema": [
      {
        "key": "usageMode",
        "type": "enum",
        "label": "Model usage breakdown metric",
        "options": ["prompts", "tokens"],
        "defaultValue": "prompts"
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 10,
        "max": 1800,
        "step": 10,
        "defaultValue": 60
      },
      {
        "key": "badgeMode",
        "type": "enum",
        "label": "Bar badge mode",
        "options": ["active", "prompts", "tokens", "off"],
        "defaultValue": "active"
      },
      {
        "key": "showBadge",
        "type": "boolean",
        "label": "Show count badge in bar",
        "defaultValue": true
      },
      {
        "key": "enableQuotaAlerts",
        "type": "boolean",
        "label": "Low quota desktop alerts",
        "defaultValue": true
      },
      {
        "key": "quotaAlertThreshold",
        "type": "integer",
        "label": "Low quota alert threshold (%)",
        "min": 5,
        "max": 50,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "terminalCommand",
        "type": "string",
        "label": "Terminal emulator override",
        "defaultValue": ""
      },
      {
        "key": "recentSessionsLimit",
        "type": "integer",
        "label": "Default recent sessions count",
        "min": 3,
        "max": 10,
        "step": 1,
        "defaultValue": 5
      }
    ]
  }
}
